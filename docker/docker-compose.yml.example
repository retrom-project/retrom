# Retrom 生产部署示例，使用以下命令启动：
#   docker compose -f docker/docker-compose.yml.example up -d
# 启动前替换本文件和 nginx.conf.example 中的示例域名、镜像 tag 与宿主数据路径。
# nginx.conf.example 只展示 HTTP 路由；正式公开前须自行配置 HTTPS、证书和端口。
# 两个镜像须来自同一发行版本，image-input label 应一致。
# /srv/retrom/data 须是本地持久目录，并允许 UID/GID 1000:1000 写入。
# 将应用域名和 *.games.example.com 指向本机，并配置覆盖二者的 TLS 证书。

services:
  postgres:
    image: postgres:18.3-bookworm@sha256:80630f83606d8db77d30b3851b16a9f78be2d0d4dda6f7b82a1fdca5ebe3acba
    restart: unless-stopped
    environment:
      POSTGRES_USER: retrom
      POSTGRES_PASSWORD: ${RETROM_POSTGRES_PASSWORD:?Set a strong database password}
      POSTGRES_DB: retrom
    volumes:
      - postgres-data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U retrom -d retrom"]
      interval: 5s
      timeout: 3s
      retries: 30
    networks:
      - retrom-network

  redis:
    image: redis:8.2.2-bookworm@sha256:4521b581dbddea6e7d81f8fe95ede93f5648aaa66a9dacd581611bf6fe7527bd
    restart: unless-stopped
    command: ["redis-server", "--save", "", "--appendonly", "no"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 30
    networks:
      - retrom-network

  retrom:
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    image: xxxsen/retrom:${RETROM_VERSION:?Set the same published release tag for both images}
    user: "1000:1000"
    restart: unless-stopped
    environment:
      # URL-encode special characters in the password; use TLS for a remote database.
      RETROM_DATABASE_URL: ${RETROM_DATABASE_URL:?Set the PostgreSQL URL for database retrom on host postgres}
      RETROM_PUBLIC_ORIGIN: "https://games.example.com"
      RETROM_REDIS_ADDR: "redis:6379"
      RETROM_RPG_RUNTIME_ORIGIN_TEMPLATE: "https://{runId}.games.example.com"
    volumes:
      - /srv/retrom/data:/var/lib/retrom
      # 可选：只读挂载已授权的 BIOS/ROM 来源，供服务器目录导入使用。
      # 管理员会在页面中选择容器文件系统内的路径。
      - /srv/roms:/server-data:ro
    networks:
      - retrom-network

  retrom-web:
    image: xxxsen/retrom-web:${RETROM_VERSION:?Set the same published release tag for both images}
    user: "1000:1000"
    restart: unless-stopped
    environment:
      # NEXT_BACKEND_ORIGIN=http://retrom:8080 is fixed at image build time.
      # Changing this container environment cannot rewrite the built routes.
      HOSTNAME: "0.0.0.0"
      # 宿主origin与隔离origin由后端run envelope提供。

      # 可选的镜像默认值及示例：
      # HOSTNAME: "0.0.0.0" # 内部监听地址，默认 0.0.0.0。
      # PORT: "3000"        # 内部 HTTP 端口；修改时同步修改 Nginx 上游。
    networks:
      - retrom-network

  nginx:
    image: nginx:1.31-trixie
    restart: unless-stopped
    depends_on:
      - retrom
      - retrom-web
    volumes:
      - ./nginx.conf.example:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "80:80"
    networks:
      - retrom-network

networks:
  retrom-network:
    ipam:
      config:
        - subnet: 172.30.50.0/24

# 镜像入口默认使用 release 模式。生产不要设置测试RETROM_MODE、PFB ID或开发Provider输入。
# Web 镜像中的 Next.js rewrite 在构建时固定；Nginx 按 nginx.conf.example
# 把 API/内容/运行时请求直接交给 retrom，不能全部转发给 retrom-web。

volumes:
  postgres-data:
