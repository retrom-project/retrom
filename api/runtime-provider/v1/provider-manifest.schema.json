{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrom.dev/schema/runtime-provider/v1/provider-manifest.schema.json",
  "title": "Retrom Runtime Provider Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "providerVersion",
    "providerApiVersion",
    "clientModulePath",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "providerId": { "$ref": "#/$defs/identity" },
    "providerVersion": { "$ref": "#/$defs/semver" },
    "providerApiVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "clientModulePath": { "const": "client.mjs" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\?#])[A-Za-z0-9._/-]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "gameCompatibilityLine",
        "netplayCompatibilityLine",
        "optionsKind",
        "capabilities",
        "inputs",
        "checkpoint",
        "assetPaths"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "gameCompatibilityLine": { "$ref": "#/$defs/token" },
        "netplayCompatibilityLine": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/token" }
          ]
        },
        "optionsKind": {
          "enum": [
            "NONE_V1",
            "EMULATORJS_V1",
            "RPGMAKER_V1",
            "ONS_PROJECT_V1",
            "KIRIKIRI_PROJECT_V1"
          ]
        },
        "capabilities": { "$ref": "#/$defs/capabilities" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/input" }
        },
        "checkpoint": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/checkpoint" }
          ]
        },
        "assetPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safePath" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pause",
        "screenshot",
        "checkpoint",
        "standardGamepad",
        "frameCounter",
        "volume",
        "discSwitch",
        "nativeSettings",
        "inputFilter",
        "netplayPort",
        "videoModes",
        "requiresThreads",
        "frameMode",
        "validationProbes"
      ],
      "properties": {
        "pause": { "type": "boolean" },
        "screenshot": { "type": "boolean" },
        "checkpoint": { "type": "boolean" },
        "standardGamepad": { "type": "boolean" },
        "frameCounter": { "type": "boolean" },
        "volume": { "type": "boolean" },
        "discSwitch": { "type": "boolean" },
        "nativeSettings": { "type": "boolean" },
        "inputFilter": { "type": "boolean" },
        "netplayPort": { "type": "boolean" },
        "videoModes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["original", "pixel", "smooth", "sharp-bilinear", "adaptive-sharpen"] }
        },
        "requiresThreads": { "type": "boolean" },
        "frameMode": {
          "enum": [
            "NONE",
            "SAME_ORIGIN_BLANK",
            "SAME_ORIGIN_RESOURCE",
            "ISOLATED_ORIGIN_RESOURCE"
          ]
        },
        "validationProbes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "cardinality", "optional"],
      "properties": {
        "role": { "$ref": "#/$defs/identity" },
        "kind": {
          "enum": [
            "ROM_BLOB_V1",
            "FILE_TREE_V1",
            "SEEKABLE_BLOB_V1",
            "NATIVE_WEB_V1",
            "ISOLATED_WEB_V1",
            "BIOS_BUNDLE_V1",
            "PARENT_ARCHIVE_V1",
            "MULTI_DISC_V1",
            "EXTERNAL_FILE_SET_V1",
            "WASM4_CART_V1"
          ]
        },
        "cardinality": { "enum": ["ONE", "MANY"] },
        "optional": { "type": "boolean" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writeFormat", "readFormats", "maxBytes"],
      "properties": {
        "writeFormat": { "$ref": "#/$defs/token" },
        "readFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/token" }
        },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
