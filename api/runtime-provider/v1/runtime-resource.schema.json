{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrom.dev/schema/runtime-provider/v1/runtime-resource.schema.json",
  "title": "Retrom Runtime Resource Definitions V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resources",
    "targetOptions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "targetOptions": {
      "$ref": "#/$defs/targetOptions"
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "relativeUrl": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2048,
      "pattern": "^/(?!/)(?!.*[\\\\#])[ -~]+$"
    },
    "httpUrl": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048,
      "pattern": "^https?://[^#]+$"
    },
    "blobResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ordinal",
        "kind",
        "url",
        "sha256",
        "sizeBytes",
        "rangeRequired"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identity"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "ROM_BLOB",
            "SEEKABLE_BLOB",
            "PARENT_ARCHIVE",
            "WASM4_CART"
          ]
        },
        "url": {
          "$ref": "#/$defs/relativeUrl"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "sizeBytes": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "rangeRequired": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "SEEKABLE_BLOB",
                  "PARENT_ARCHIVE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "rangeRequired": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "rangeRequired": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "fileTreeResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ordinal",
        "kind",
        "indexUrl",
        "contentDigest"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identity"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "const": "FILE_TREE"
        },
        "indexUrl": {
          "$ref": "#/$defs/relativeUrl"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "webResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ordinal",
        "kind",
        "origin",
        "entryUrl",
        "contentDigest",
        "indexUrl",
        "entryFile",
        "bridgeUrl"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identity"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "NATIVE_WEB",
            "ISOLATED_WEB"
          ]
        },
        "indexUrl": {
          "$ref": "#/$defs/relativeUrl"
        },
        "origin": {
          "$ref": "#/$defs/httpUrl"
        },
        "entryUrl": {
          "$ref": "#/$defs/httpUrl"
        },
        "contentDigest": {
          "$ref": "#/$defs/digest"
        },
        "entryFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001F\\u007F])(?!.*\\/$).+$"
        },
        "bridgeUrl": {
          "$ref": "#/$defs/bridgeUrl"
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalName",
        "virtualPath",
        "url",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "logicalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "virtualPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001F\\u007F])(?!.*\\/$).+$"
        },
        "url": {
          "$ref": "#/$defs/relativeUrl"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "sizeBytes": {
          "$ref": "#/$defs/positiveSafeInteger"
        }
      }
    },
    "fileSetResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "ordinal",
        "kind",
        "files"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/identity"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "BIOS_BUNDLE",
            "EXTERNAL_FILE_SET"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fileEntry"
          }
        }
      }
    },
    "resource": {
      "oneOf": [
        {
          "$ref": "#/$defs/blobResource"
        },
        {
          "$ref": "#/$defs/fileTreeResource"
        },
        {
          "$ref": "#/$defs/webResource"
        },
        {
          "$ref": "#/$defs/fileSetResource"
        }
      ]
    },
    "targetOptions": {
      "$ref": "common.schema.json#/$defs/jsonObject"
    },
    "bridgeUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^/runtime/providers/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?/[0-9a-f]{64}/assets/(?!\\.{1,2}/)(?!.*\\/\\.{1,2}/)[a-zA-Z0-9_./-]+/bridge\\.js$"
    }
  }
}
