{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrom.dev/schema/runtime-provider/v1/launch-envelope.schema.json",
  "title": "Retrom Launch Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "session",
    "runtime",
    "resources",
    "targetOptions",
    "restore"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "resources": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "runtime-resource.schema.json#/$defs/resource"
      }
    },
    "targetOptions": {
      "$ref": "runtime-resource.schema.json#/$defs/targetOptions"
    },
    "restore": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/restore"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "capabilities": {
                "properties": {
                  "checkpoint": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "checkpoint": {
                "$ref": "provider-manifest.schema.json#/$defs/checkpoint"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "runtime": {
            "properties": {
              "checkpoint": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "mode",
        "title",
        "platformName",
        "coreName",
        "returnTo",
        "warnings"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "purpose": {
          "enum": [
            "PRODUCT",
            "REVIEW_PREVIEW"
          ]
        },
        "mode": {
          "enum": [
            "SINGLE"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "platformName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "coreName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "returnTo": {
          "$ref": "common.schema.json#/$defs/relativeUrl"
        },
        "warnings": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "providerVersion",
        "providerApiVersion",
        "bundleSha256",
        "targetId",
        "capabilities",
        "checkpoint",
        "moduleUrl",
        "moduleSha256",
        "runtimeBaseUrl"
      ],
      "properties": {
        "providerId": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "providerVersion": {
          "$ref": "common.schema.json#/$defs/semver"
        },
        "providerApiVersion": {
          "const": 1
        },
        "bundleSha256": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "targetId": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "capabilities": {
          "$ref": "provider-manifest.schema.json#/$defs/capabilities"
        },
        "checkpoint": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "provider-manifest.schema.json#/$defs/checkpoint"
            }
          ]
        },
        "moduleUrl": {
          "$ref": "common.schema.json#/$defs/relativeUrl"
        },
        "moduleSha256": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "runtimeBaseUrl": {
          "$ref": "common.schema.json#/$defs/relativeUrl"
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "format",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "url": {
          "$ref": "common.schema.json#/$defs/relativeUrl"
        },
        "format": {
          "$ref": "common.schema.json#/$defs/token"
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "sizeBytes": {
          "$ref": "common.schema.json#/$defs/positiveSafeInteger"
        }
      }
    }
  }
}
