{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrom.dev/schema/runtime-provider/v1/launch-envelope.schema.json",
  "title": "Retrom Launch Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "session", "runtime", "resources", "targetOptions", "restore", "validation", "netplay"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "session": { "$ref": "#/$defs/session" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "resources": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "runtime-resource.schema.json#/$defs/resource" }
    },
    "targetOptions": { "$ref": "runtime-resource.schema.json#/$defs/targetOptions" },
    "restore": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/restore" }] },
    "validation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/validation" }] },
    "netplay": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/netplay" }] }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": {
              "capabilities": { "properties": { "checkpoint": { "const": true } } }
            }
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "properties": {
              "checkpoint": { "$ref": "provider-manifest.schema.json#/$defs/checkpoint" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "runtime": { "properties": { "checkpoint": { "type": "null" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "session": { "properties": { "mode": { "const": "NETPLAY" } } }
        }
      },
      "then": {
        "properties": {
          "netplay": { "$ref": "#/$defs/netplay" },
          "runtime": {
            "properties": {
              "capabilities": { "properties": { "netplayPort": { "const": true } } }
            }
          }
        }
      },
      "else": { "properties": { "netplay": { "type": "null" } } }
    }
  ],
  "$defs": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "mode", "title", "platformName", "coreName", "returnTo", "warnings"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/uuid" },
        "purpose": { "enum": ["PRODUCT", "REVIEW_PREVIEW", "RUNTIME_VALIDATION"] },
        "mode": { "enum": ["SINGLE", "NETPLAY"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "platformName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "coreName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "returnTo": { "$ref": "common.schema.json#/$defs/relativeUrl" },
        "warnings": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId", "providerVersion", "providerApiVersion", "bundleSha256", "targetId",
        "capabilities", "checkpoint", "moduleUrl", "moduleSha256", "runtimeBaseUrl"
      ],
      "properties": {
        "providerId": { "$ref": "common.schema.json#/$defs/identity" },
        "providerVersion": { "$ref": "common.schema.json#/$defs/semver" },
        "providerApiVersion": { "const": 1 },
        "bundleSha256": { "$ref": "common.schema.json#/$defs/digest" },
        "targetId": { "$ref": "common.schema.json#/$defs/identity" },
        "capabilities": { "$ref": "provider-manifest.schema.json#/$defs/capabilities" },
        "checkpoint": { "oneOf": [{ "type": "null" }, { "$ref": "provider-manifest.schema.json#/$defs/checkpoint" }] },
        "moduleUrl": { "$ref": "common.schema.json#/$defs/relativeUrl" },
        "moduleSha256": { "$ref": "common.schema.json#/$defs/digest" },
        "runtimeBaseUrl": { "$ref": "common.schema.json#/$defs/relativeUrl" }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "format", "sha256", "sizeBytes"],
      "properties": {
        "url": { "$ref": "common.schema.json#/$defs/relativeUrl" },
        "format": { "$ref": "common.schema.json#/$defs/token" },
        "sha256": { "$ref": "common.schema.json#/$defs/digest" },
        "sizeBytes": { "$ref": "common.schema.json#/$defs/positiveSafeInteger" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probeId", "input"],
      "properties": {
        "probeId": { "$ref": "common.schema.json#/$defs/token" },
        "input": { "$ref": "common.schema.json#/$defs/jsonObject" }
      }
    },
    "netplayProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleSha256", "canonicalHistoryFrames", "checkpointEveryFrames", "controlCount", "coreId",
        "dependencySnapshotDigest", "maxPlayers", "maxPredictionFrames", "maxRollbackFrames", "maxStateBytes",
        "platformIds", "profileId", "protocolVersion", "providerId", "schemaVersion", "sourceManifestDigest", "targetId"
      ],
      "properties": {
        "bundleSha256": { "$ref": "common.schema.json#/$defs/digest" },
        "canonicalHistoryFrames": { "const": 600 },
        "checkpointEveryFrames": { "const": 120 },
        "controlCount": { "const": 24 },
        "coreId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dependencySnapshotDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "maxPlayers": { "type": "integer", "minimum": 2, "maximum": 4 },
        "maxPredictionFrames": { "type": "integer", "minimum": 0, "maximum": 8 },
        "maxRollbackFrames": { "const": 120 },
        "maxStateBytes": { "const": 1048576 },
        "platformIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "profileId": { "$ref": "common.schema.json#/$defs/identity" },
        "protocolVersion": { "const": "retrom-netplay-v2" },
        "providerId": { "$ref": "common.schema.json#/$defs/identity" },
        "schemaVersion": { "const": 2 },
        "sourceManifestDigest": { "$ref": "common.schema.json#/$defs/digest" },
        "targetId": { "$ref": "common.schema.json#/$defs/identity" }
      }
    },
    "netplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomId", "sessionId", "playerNo", "socketUrl", "profile"],
      "properties": {
        "roomId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "$ref": "common.schema.json#/$defs/uuid" },
        "playerNo": { "type": "integer", "minimum": 1, "maximum": 16 },
        "socketUrl": { "$ref": "common.schema.json#/$defs/webSocketUrl" },
        "profile": { "$ref": "#/$defs/netplayProfile" }
      }
    }
  }
}
