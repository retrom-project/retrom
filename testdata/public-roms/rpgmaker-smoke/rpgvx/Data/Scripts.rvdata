[[i"Retrom Smoke";x0Ïø# Retrom project-owned RGSS smoke program. MIT-licensed; no RPG Maker default
# script or Runtime Package content is required.
class RetromMap
  attr_reader :map_id
  def initialize
    @map_id = 1
  end
end

class RetromPlayer
  attr_accessor :x, :y
  def initialize
    @x = 10
    @y = 8
  end
end

$game_map = RetromMap.new
$game_player = RetromPlayer.new
$game_variables = Array.new(10, 0)
RETROM_MARKER = "RETROM RPGVX"

background = Bitmap.new(Graphics.width, Graphics.height)
surface = Sprite.new
surface.bitmap = background
cursor = Sprite.new
cursor.bitmap = Bitmap.new(24, 24)
cursor.bitmap.fill_rect(0, 0, 24, 24, Color.new(255, 255, 255, 255))

Audio.se_play("Audio/SE/retrom-tone", 70, 100)

loop do
  Input.update
  $game_player.x -= 1 if Input.repeat?(Input::LEFT) && $game_player.x > 0
  $game_player.x += 1 if Input.repeat?(Input::RIGHT) && $game_player.x < 19
  $game_player.y -= 1 if Input.repeat?(Input::UP) && $game_player.y > 0
  $game_player.y += 1 if Input.repeat?(Input::DOWN) && $game_player.y < 14
  if Input.trigger?(Input::C)
    $game_variables[1] = ($game_variables[1] + 1) % 3
  end

  background.clear
  background.fill_rect(0, 0, Graphics.width, Graphics.height, Color.new(15, 23, 42, 255))
  background.fill_rect(16, 16, Graphics.width - 32, 80, Color.new(168, 85, 247, 255))
  background.fill_rect(24, 32, 16 + ($game_variables[1] * 24), 32, Color.new(255, 255, 255, 255))
  cursor.x = $game_player.x * 24 + 8
  cursor.y = $game_player.y * 24 + 104
  Graphics.update
  # Acceptance observes the authored game's real state, not a Provider probe.
  # Periodic output also emits the restored VM state without modifying it.
  if Graphics.frame_count % 30 == 0
    puts "RETROM_FIXTURE_STATE_V1:#{Graphics.frame_count}:#{$game_map.map_id}:#{$game_player.x}:#{$game_player.y}:#{$game_variables[1]}"
  end
end
HCH=