{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrom.invalid/schemas/netplay-manifest-v4.json",
  "title": "Retrom netplay core profile allowlist manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocol", "profiles"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "playerAdapterId", "netplayAdapterId", "controlCount", "checkpointEveryFrames", "maxPredictionFrames", "maxRollbackFrames", "canonicalHistoryFrames", "maxStateBytes", "allowedContentKinds"],
      "properties": {
        "version": { "const": "retrom-netplay-v2" },
        "playerAdapterId": { "const": "ejs-4.2.3-v3" },
        "netplayAdapterId": { "const": "ejs-netplay-4.2.3-v2" },
        "controlCount": { "const": 24 },
        "checkpointEveryFrames": { "const": 120 },
        "maxPredictionFrames": { "const": 8 },
        "maxRollbackFrames": { "const": 120 },
        "canonicalHistoryFrames": { "const": 600 },
        "maxStateBytes": { "const": 1048576 },
        "allowedContentKinds": { "const": ["SINGLE_FILE"] }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "emulatorjsVersion", "coreId", "platformIds", "coreArtifactSha256", "maxPlayers", "maxPredictionFrames"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "emulatorjsVersion": { "const": "4.2.3" },
          "coreId": { "enum": ["fceumm", "fbneo", "snes9x", "mame2003", "mame2003_plus", "fbalpha2012_cps1", "fbalpha2012_cps2", "nestopia"] },
          "platformIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }
          },
          "coreArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "maxPlayers": { "type": "integer", "minimum": 2, "maximum": 4 },
          "maxPredictionFrames": { "type": "integer", "minimum": 0, "maximum": 8 }
        }
      }
    }
  }
}
