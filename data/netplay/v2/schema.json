{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retrom.invalid/schemas/netplay-manifest-v5.json",
  "title": "Retrom Provider Target netplay profile manifest v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocol", "profiles"],
  "properties": {
    "schemaVersion": {"const": 5},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "controlCount", "checkpointEveryFrames", "maxPredictionFrames", "maxRollbackFrames", "canonicalHistoryFrames", "maxStateBytes", "allowedContentKinds"],
      "properties": {
        "version": {"const": "retrom-netplay-v2"},
        "controlCount": {"const": 24},
        "checkpointEveryFrames": {"const": 120},
        "maxPredictionFrames": {"const": 8},
        "maxRollbackFrames": {"const": 120},
        "canonicalHistoryFrames": {"const": 600},
        "maxStateBytes": {"const": 1048576},
        "allowedContentKinds": {"const": ["SINGLE_FILE"]}
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "providerId", "targetId", "coreId", "platformIds", "maxPlayers", "maxPredictionFrames"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
          "providerId": {"const": "emulatorjs"},
          "targetId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "coreId": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
          "platformIds": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"}},
          "maxPlayers": {"type": "integer", "minimum": 2, "maximum": 4},
          "maxPredictionFrames": {"type": "integer", "minimum": 0, "maximum": 8}
        }
      }
    }
  }
}
