# Local game payloads. ROM, BIOS, screenshots, and other proprietary game
# content must never be committed; assets-manifest.json remains tracked.
/assets/roms/
/assets/bios/
/assets/screenshots/
/assets/captures/

# Materialized EmulatorJS runtime, cores, and third-party license payloads.
# They are reproduced and verified by tools/prepare-assets.mjs.
/vendor/

# Package-manager dependencies and local caches.
/node_modules/
/.cache/
/.npm/

# Browser/unit-test output.
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Local temporary/runtime state.
/.tmp/
/tmp/
*.log
*.pid
*.pid.lock

# Machine-local configuration and credentials. A documented example may be
# committed explicitly as .env.example.
.env
.env.*
!.env.example

# Editor and operating-system metadata.
/.idea/
/.vscode/
.DS_Store
Thumbs.db
